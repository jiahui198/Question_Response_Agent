"""
.venv/存放虚拟环境
.env.example存放环境变量的配置模版
"""

#---应用----
APP_NAME = question-response-agent
APP_ENV = dev
APP_HOST = 0.0.0.0
APP_PORT = 8000

#---MySQL---
MYSQL_HOST = 127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=question_response_agent

#---Redis(第7步采用，现在留空)---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT 鉴权 ----
# 生成命令: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET =please_change_me_to_random_32_chars
JWT_ALGORITHM =HS256
JWT_EXPIRE_MINUTES = 1440

#---LLM(Dashscope通义千问)----
DASHSCOPE_API_KEY =sk-your_dashscope_api_key_here
LLM_MODEL=qwen-plus